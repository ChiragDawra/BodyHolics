# ---------------------------------------------------------------------------
# Client-safe. These end up inside a shipped bundle. Never put a secret here.
# ---------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
EXPO_PUBLIC_APP_ENV=local
EXPO_PUBLIC_JOIN_BASE_URL=http://localhost:3000/j

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key
NEXT_PUBLIC_APP_ENV=local

# The domain a bare staff username is completed with at the login form, so the
# owner can type `ChiragDawra` rather than a full address. Not a secret: it is
# visible in the login request and in the account's own address. Must match the
# domain `scripts/bootstrap-gym.mjs` created the OWNER account under.
NEXT_PUBLIC_ADMIN_USERNAME_DOMAIN=staff.bodyholics.app

# ---------------------------------------------------------------------------
# Server-only. Edge Function secrets / Vercel encrypted / GitHub Actions secrets.
# A value below must NEVER be re-exported under EXPO_PUBLIC_ or NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me

EXPO_ACCESS_TOKEN=replace-me
